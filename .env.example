# Recipient 1 (required) - your bot from BotFather, your chat id
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# Recipient 2 (optional) - a second person's OWN bot and OWN chat id.
# Each recipient brings their own bot token. Add _3, _4, ... for more;
# the scan stops at the first missing pair.
TELEGRAM_BOT_TOKEN_2=
TELEGRAM_CHAT_ID_2=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
